{
  "version": 1,
  "defaults": {
    "capabilities": {
      "reasoning": null,
      "functionCall": null,
      "imageInput": null
    }
  },
  "profiles": [
    {
      "id": "deepseek-reasoning-family",
      "priority": 100,
      "match": {
        "model": ["deepseek-v4*", "deepseek/deepseek-v4*", "deepseek-r1*", "deepseek/deepseek-r1*"]
      },
      "family": "deepseek",
      "capabilities": { "reasoning": true, "functionCall": true },
      "reasoning": { "supportedEfforts": ["none", "low", "high", "max"], "defaultEffort": "high" },
      "sources": [{ "url": "docs/reasoning/deepseek.md", "verifiedAt": "2026-08-28" }]
    },
    {
      "id": "qwen-vision-family",
      "priority": 80,
      "match": { "model": ["qwen*-vl-*", "qwen*-vision-*"] },
      "family": "qwen",
      "capabilities": { "imageInput": true }
    },
    {
      "id": "qwen-reasoning-family",
      "priority": 100,
      "match": { "model": ["qwen-qwq*", "qwq*"] },
      "family": "qwen",
      "capabilities": { "reasoning": true },
      "reasoning": { "supportedEfforts": ["none", "high"], "defaultEffort": "high" },
      "sources": [{ "url": "docs/reasoning/qwen.md", "verifiedAt": "2026-08-28" }]
    },
    {
      "id": "qwen3-thinking-family",
      "priority": 100,
      "match": { "model": ["qwen3.5*", "qwen3.6*", "qwen3.7*", "qwen3.8*", "qwen3-*"] },
      "family": "qwen",
      "capabilities": { "reasoning": true, "functionCall": true },
      "reasoning": { "supportedEfforts": ["none", "high"], "defaultEffort": "high" },
      "sources": [{ "url": "docs/reasoning/qwen.md", "verifiedAt": "2026-08-28" }]
    },
    {
      "id": "qwen-thinking-default-off-family",
      "priority": 110,
      "match": { "model": ["qwen3-max*", "qwen-plus*", "qwen-flash*", "qwen-turbo*"] },
      "family": "qwen",
      "capabilities": { "reasoning": true, "functionCall": true },
      "reasoning": { "supportedEfforts": ["none", "high"], "defaultEffort": "none" },
      "sources": [{ "url": "docs/reasoning/qwen.md", "verifiedAt": "2026-08-28" }]
    },
    {
      "id": "hunyuan-hy4-preview",
      "priority": 200,
      "match": { "model": ["hy4-preview", "hunyuan/hy4-preview", "hunyuan-hy4-preview"] },
